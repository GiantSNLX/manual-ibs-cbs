---
// Hero da página inicial (escolhido por Hero.astro): título, explicação e a busca em destaque.
const PAGE_TITLE_ID = '_top'; // mesmo id que o Starlight usa no título da página
const { data } = Astro.locals.starlightRoute.entry;
const { tagline = '' } = data.hero || {};
const exemplos = ['Suframa', 'crédito presumido', 'split payment', 'art. 444'];
---

<section class="inicio-hero" aria-labelledby={PAGE_TITLE_ID}>
  <div class="inicio-wrap"><div class="inicio-hero-conteudo">
    <p class="inicio-sobre">Reforma tributária do consumo</p>
    <h1 id={PAGE_TITLE_ID} data-page-title>
      IBS e CBS na Zona Franca de Manaus, no Amazonas e em Roraima
    </h1>
    <p class="inicio-linha" set:html={tagline} />

    <button type="button" class="busca-grande" data-abrir-busca>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7" /><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      <span>Pesquisar no manual e na lei</span>
      <kbd>Ctrl K</kbd>
    </button>
    <p class="busca-exemplos">
      <span>Por exemplo:</span>
      {exemplos.map((e) => <button type="button" data-abrir-busca={e}>{e}</button>)}
    </p>
  </div></div>
</section>

<script>
  // Abre a busca do Starlight (a mesma do Ctrl K); os exemplos já preenchem o termo.
  const abrir = (termo?: string) => {
    document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
    if (!termo) return;
    let tentativas = 0;
    const preencher = () => {
      const campo = document.querySelector<HTMLInputElement>('site-search .pagefind-ui__search-input');
      if (campo) {
        campo.value = termo;
        campo.dispatchEvent(new Event('input', { bubbles: true }));
        campo.focus();
      } else if (tentativas++ < 40) {
        setTimeout(preencher, 50);
      }
    };
    preencher();
  };
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-busca]').forEach((b) =>
    // Fora do clique atual: senão o mesmo clique, ao subir até a janela, fecha o modal recém-aberto.
    b.addEventListener('click', () => setTimeout(() => abrir(b.dataset.abrirBusca || undefined))),
  );
</script>
