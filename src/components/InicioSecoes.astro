---
// Seções da página inicial, na ordem em que o leitor costuma precisar:
// 1) ir direto à sua situação; 2) estudar pelo manual; 3) consultar a lei; 4) entender como ler.
import { getCollection } from 'astro:content';
import legislacao from '../data/legislacao.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => base + p;

// Situações mais procuradas, cada uma levando ao trecho exato do capítulo.
const situacoes = [
  { titulo: 'Vendo para a Zona Franca de Manaus a partir de outra região', texto: 'Alíquota zero na venda e o que muda para quem compra.', link: '/manual/zona-franca-de-manaus/#alíquota-zero-na-venda-para-a-zfm' },
  { titulo: 'Importo mercadoria para revender na ZFM', texto: 'Crédito presumido de IBS na importação para revenda.', link: '/manual/zona-franca-de-manaus/#crédito-presumido-de-ibs-na-importação-para-revenda' },
  { titulo: 'Sou indústria incentivada na ZFM', texto: 'Créditos presumidos de IBS e de CBS na saída dos produtos.', link: '/manual/zona-franca-de-manaus/#crédito-presumido-na-saída-da-indústria-incentivada' },
  { titulo: 'Preciso me habilitar na Suframa', texto: 'Quem pode usar o regime e o que a habilitação exige.', link: '/manual/zona-franca-de-manaus/#habilitação-na-suframa' },
  { titulo: 'Opero em uma Área de Livre Comércio', texto: 'Boa Vista, Bonfim, Tabatinga e as demais: o que vale no IBS e na CBS.', link: '/manual/areas-de-livre-comercio/#benefícios-do-ibs-e-da-cbs' },
  { titulo: 'Quero saber o que muda em cada ano', texto: 'O calendário da transição de 2026 a 2033.', link: '/manual/visao-geral/#cronograma-de-transição-2026-a-2033' },
];

const capitulos = (await getCollection('docs', (e) => e.id.startsWith('manual/')))
  .filter((e) => (e.data.sidebar?.order ?? 0) > 0)
  .sort((a, b) => (a.data.sidebar?.order ?? 0) - (b.data.sidebar?.order ?? 0));
const PARTES = [
  { nome: 'Os fundamentos', texto: 'Como o IBS e a CBS funcionam em todo o país: incidência, cálculo, créditos, pagamento e administração.', de: 1, ate: 5 },
  { nome: 'A Zona Franca de Manaus', texto: 'O regime favorecido da ZFM e seus efeitos no IPI, no Imposto Seletivo e nos fundos.', de: 6, ate: 7 },
  { nome: 'Áreas de Livre Comércio e estados', texto: 'As ALC e as regras próprias de Roraima e do Amazonas.', de: 8, ate: 10 },
];
const partes = PARTES.map((p) => ({
  ...p,
  itens: capitulos.filter((c) => {
    const o = c.data.sidebar?.order ?? 0;
    return o >= p.de && o <= p.ate;
  }),
}));

const GRUPOS: Record<string, string> = {
  federal: 'Constituição e leis federais',
  cgibs: 'Comitê Gestor do IBS',
  'zfm-alc': 'Zona Franca e Áreas de Livre Comércio',
  amazonas: 'Amazonas',
  roraima: 'Roraima',
};
const grupo = (id: string) => ({ id, nome: GRUPOS[id], normas: legislacao.filter((n) => n.grupo === id) });
// Primeira linha: federal, Comitê Gestor e estados; a ZFM (a maior) vem em linha própria, em colunas.
const colunas = [[grupo('federal')], [grupo('cgibs')], [grupo('amazonas'), grupo('roraima')]];
const zfm = grupo('zfm-alc');
const nome = (r: string) => r.replace(/\s*\(([^)]*)\)\s*$/, '');
const nota = (r: string) => (r.match(/\(([^)]*)\)\s*$/) || [])[1] || '';
---

<div class="inicio not-content">
  <section class="inicio-secao" aria-labelledby="sec-situacoes">
    <div class="inicio-wrap">
      <h2 id="sec-situacoes">Comece pela sua situação</h2>
      <p class="inicio-intro">As dúvidas mais comuns, cada uma levando direto ao trecho do manual que responde.</p>
      <ul class="situacoes">
        {situacoes.map((s) => (
          <li>
            <a class="cartao" href={url(s.link)}>
              <span class="cartao-titulo">{s.titulo}</span>
              <span class="cartao-texto">{s.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="inicio-secao inicio-secao-alt" aria-labelledby="sec-manual">
    <div class="inicio-wrap">
      <h2 id="sec-manual">O manual em três partes</h2>
      <p class="inicio-intro">Para estudar o tema do começo. Comece pelos fundamentos se a reforma ainda é novidade; vá direto às partes regionais se já conhece a base.</p>
      <div class="partes">
        {partes.map((p) => (
          <div class="parte">
            <h3>{p.nome}</h3>
            <p>{p.texto}</p>
            <ul>
              {p.itens.map((c) => <li><a href={url(`/${c.id}/`)}>{c.data.title}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="inicio-secao" aria-labelledby="sec-lei">
    <div class="inicio-wrap">
      <h2 id="sec-lei">A legislação completa</h2>
      <p class="inicio-intro">Todas as normas citadas no manual, no texto oficial e atualizado até a data de captura, com link direto para cada artigo.</p>
      <div class="normas">
        {colunas.map((col) => (
          <div>
            {col.map((g) => (
              <div class="grupo">
                <h3>{g.nome}</h3>
                <ul>
                  {g.normas.map((n) => (
                    <li>
                      <a href={url(n.link)}>{nome(n.rotulo)}</a>
                      {nota(n.rotulo) && <span>{nota(n.rotulo)}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
        <div class="grupo grupo-largo">
          <h3>{zfm.nome}</h3>
          <ul>
            {zfm.normas.map((n) => (
              <li>
                <a href={url(n.link)}>{nome(n.rotulo)}</a>
                {nota(n.rotulo) && <span>{nota(n.rotulo)}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="inicio-secao inicio-secao-alt" aria-labelledby="sec-ler">
    <div class="inicio-wrap">
      <h2 id="sec-ler">Como ler este manual</h2>
      <div class="ler">
        <div>
          <h3>Cada regra cita a lei</h3>
          <p>A referência no texto, como “art. 444 da LC 214/2025”, abre o artigo exato. Dentro da lei, clique no número do artigo para copiar o link dele.</p>
        </div>
        <div>
          <h3>Os avisos merecem atenção</h3>
          <p>Os quadros em amarelo indicam quando lei e regulamento divergem, quando falta um ato oficial ou quando o texto admite mais de uma leitura.</p>
        </div>
        <div>
          <h3>Material de consulta</h3>
          <p>O texto legal vem das publicações oficiais e pode ter mudado depois da data de captura. Para uma decisão fiscal, confira a fonte. <a href={url('/fontes/')}>Ver fontes e datas</a>.</p>
        </div>
      </div>
    </div>
  </section>
</div>
