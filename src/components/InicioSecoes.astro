---
// Seções da página inicial, na ordem em que o leitor costuma precisar:
// 1) ir direto à sua situação; 2) estudar pelo manual; 3) consultar a lei; 4) entender como ler.
import { getCollection } from 'astro:content';
import legislacao from '../data/legislacao.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => base + p;

// Situações mais procuradas, cada uma levando ao trecho exato do capítulo.
const situacoes = [
  { icone: 'venda', area: 'zfm', titulo: 'Vendo para a Zona Franca de Manaus a partir de outra região', texto: 'Alíquota zero na venda e o que muda para quem compra.', link: '/manual/zona-franca-de-manaus/#alíquota-zero-na-venda-para-a-zfm' },
  { icone: 'importa', area: 'zfm', titulo: 'Importo mercadoria para revender na ZFM', texto: 'Crédito presumido de IBS na importação para revenda.', link: '/manual/zona-franca-de-manaus/#crédito-presumido-de-ibs-na-importação-para-revenda' },
  { icone: 'industria', area: 'zfm', titulo: 'Sou indústria incentivada na ZFM', texto: 'Créditos presumidos de IBS e de CBS na saída dos produtos.', link: '/manual/zona-franca-de-manaus/#crédito-presumido-na-saída-da-indústria-incentivada' },
  { icone: 'suframa', area: 'zfm', titulo: 'Preciso me habilitar na Suframa', texto: 'Quem pode usar o regime e o que a habilitação exige.', link: '/manual/zona-franca-de-manaus/#habilitação-na-suframa' },
  { icone: 'alc', area: 'alc', titulo: 'Opero em uma Área de Livre Comércio', texto: 'Boa Vista, Bonfim, Tabatinga e as demais: o que vale no IBS e na CBS.', link: '/manual/areas-de-livre-comercio/#benefícios-do-ibs-e-da-cbs' },
  { icone: 'ano', area: 'fund', titulo: 'Quero saber o que muda em cada ano', texto: 'O calendário da transição de 2026 a 2033.', link: '/manual/visao-geral/#cronograma-de-transição-2026-a-2033' },
];

const ICONES: Record<string, string> = {venda: `<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>`, importa: `<path d="M3 15l2 4h14l2-4H3z"/><path d="M6 15V9h12v6M9 9V5h6v4"/>`, industria: `<path d="M3 20V10l5 3V10l5 3V6h4v14H3z"/><path d="M7 17h2M12 17h2"/>`, suframa: `<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 14l2 2 4-4"/>`, alc: `<path d="M12 21s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/>`, ano: `<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>`};
const svg = (k: string) => `<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONES[k]}</svg>`;
const ROMANOS = ['I', 'II', 'III'];
const AREAS = ['fund', 'zfm', 'alc'];

const capitulos = (await getCollection('docs', (e) => e.id.startsWith('manual/')))
  .filter((e) => (e.data.sidebar?.order ?? 0) > 0)
  .sort((a, b) => (a.data.sidebar?.order ?? 0) - (b.data.sidebar?.order ?? 0));
const PARTES = [
  { nome: 'Os fundamentos', texto: 'Como o IBS e a CBS funcionam em todo o país: incidência, cálculo, créditos, pagamento e administração.', de: 1, ate: 5 },
  { nome: 'A Zona Franca de Manaus', texto: 'O regime favorecido da ZFM e seus efeitos no IPI, no Imposto Seletivo e nos fundos.', de: 6, ate: 7 },
  { nome: 'Áreas de Livre Comércio e estados', texto: 'As ALC e as regras próprias de Roraima e do Amazonas.', de: 8, ate: 10 },
];
const partes = PARTES.map((p) => ({
  ...p,
  itens: capitulos.filter((c) => {
    const o = c.data.sidebar?.order ?? 0;
    return o >= p.de && o <= p.ate;
  }),
}));

const GRUPOS: Record<string, string> = {
  federal: 'Constituição e leis federais',
  cgibs: 'Comitê Gestor do IBS',
  'zfm-alc': 'Zona Franca e Áreas de Livre Comércio',
  amazonas: 'Amazonas',
  roraima: 'Roraima',
};
const AREA_GRUPO: Record<string, string> = { federal: 'fund', cgibs: 'fund', 'zfm-alc': 'zfm', amazonas: 'alc', roraima: 'alc' };
const grupo = (id: string) => ({ id, area: AREA_GRUPO[id], nome: GRUPOS[id], normas: legislacao.filter((n) => n.grupo === id) });
// Primeira linha: federal, Comitê Gestor e estados; a ZFM (a maior) vem em linha própria, em colunas.
const colunas = [[grupo('federal')], [grupo('cgibs')], [grupo('amazonas'), grupo('roraima')]];
const zfm = grupo('zfm-alc');
const nome = (r: string) => r.replace(/\s*\(([^)]*)\)\s*$/, '');
const nota = (r: string) => (r.match(/\(([^)]*)\)\s*$/) || [])[1] || '';
---

<div class="inicio not-content">
  <section class="inicio-secao" aria-labelledby="sec-situacoes">
    <div class="inicio-wrap">
      <p class="secao-rotulo">Atalhos</p>
      <h2 id="sec-situacoes">Comece pela sua situação</h2>
      <p class="inicio-intro">As dúvidas mais comuns, cada uma levando direto ao trecho do manual que responde.</p>
      <ul class="situacoes">
        {situacoes.map((s) => (
          <li>
            <a class="cartao" data-area={s.area} href={url(s.link)}>
              <span class="cartao-icone" set:html={svg(s.icone)} />
              <span class="cartao-titulo">{s.titulo}</span>
              <span class="cartao-texto">{s.texto}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="inicio-secao inicio-secao-alt" aria-labelledby="sec-manual">
    <div class="inicio-wrap">
      <p class="secao-rotulo">Para estudar</p>
      <h2 id="sec-manual">O manual em três partes</h2>
      <p class="inicio-intro">Para estudar o tema do começo. Comece pelos fundamentos se a reforma ainda é novidade; vá direto às partes regionais se já conhece a base.</p>
      <div class="partes">
        {partes.map((p, i) => (
          <div class="parte" data-area={AREAS[i]}>
            <span class="parte-num" aria-hidden="true">{ROMANOS[i]}</span>
            <h3>{p.nome}</h3>
            <p>{p.texto}</p>
            <ul>
              {p.itens.map((c) => <li><a href={url(`/${c.id}/`)}>{c.data.title}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="inicio-secao" aria-labelledby="sec-lei">
    <div class="inicio-wrap">
      <p class="secao-rotulo">Para consultar</p>
      <h2 id="sec-lei">A legislação completa</h2>
      <p class="inicio-intro">Todas as normas citadas no manual, no texto oficial e atualizado até a data de captura, com link direto para cada artigo.</p>
      <div class="normas">
        {colunas.map((col) => (
          <div>
            {col.map((g) => (
              <div class="grupo" data-area={g.area}>
                <h3>{g.nome}</h3>
                <ul>
                  {g.normas.map((n) => (
                    <li>
                      <a href={url(n.link)}>{nome(n.rotulo)}</a>
                      {nota(n.rotulo) && <span>{nota(n.rotulo)}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
        <div class="grupo grupo-largo" data-area={zfm.area}>
          <h3>{zfm.nome}</h3>
          <ul>
            {zfm.normas.map((n) => (
              <li>
                <a href={url(n.link)}>{nome(n.rotulo)}</a>
                {nota(n.rotulo) && <span>{nota(n.rotulo)}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</div>
